# Only allowlisted paths appear in logs. Never log $request, $request_uri or $args.
map $uri $safe_route {
    default "other";
    /api/auth/context "/api/auth/context";
    /api/auth/login "/api/auth/login";
    /api/auth/logout "/api/auth/logout";
    /api/employees "/api/employees";
    /proxy-health "/proxy-health";
    /health "/health";
    /internal/check/employee "/internal/check/employee";
}
log_format portal escape=json '{"timestamp":"$time_iso8601","request_id":"$request_id","method":"$request_method","route":"$safe_route","status":$status,"request_time":$request_time,"upstream_response_time":"$upstream_response_time","upstream_status":"$upstream_status"}';
# Standard Nginx error messages may include raw request URIs. Use access events for this MVP.
error_log /dev/null crit;
access_log /var/log/nginx/portal-access.jsonl portal;
server {
    listen 80;
    server_tokens off;
    client_max_body_size 8k;
    client_body_timeout 5s;
    add_header X-Request-ID $request_id always;
    add_header Cache-Control no-store always;
    location = /proxy-health { default_type application/json; return 200 '{"status":"ok"}'; }
    location ^~ /internal/ { return 404; }
    location / {
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Proxy-Key "${PROXY_SECRET}";
        proxy_hide_header X-Request-ID;
        proxy_hide_header Cache-Control;
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
    }
}
# Separate internal listener. Host port is bound to loopback in local compose.
server {
    listen 8081;
    server_tokens off;
    add_header X-Request-ID $request_id always;
    location = /internal/check/employee {
        proxy_pass http://api:8000;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Proxy-Key "${PROXY_SECRET}";
        proxy_hide_header X-Request-ID;
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
    }
    location / { return 404; }
}
